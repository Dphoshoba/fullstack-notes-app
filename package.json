{
  "name": "express-mongodb-auth-api",
  "version": "1.0.0",
  "description": "A full Node.js API with Express, MongoDB, JWT authentication, and protected CRUD routes.",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:api": "nodemon src/server.js",
    "dev:client": "npm run dev --prefix client",
    "dev:full": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "start": "node src/server.js",
    "lint": "eslint src client",
    "lint:fix": "eslint src client --fix",
    "seed": "node src/scripts/seed.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=unit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=integration"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "http-status-codes": "^2.3.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nanoid": "^5.0.7",
    "openai": "^6.35.0",
    "resend": "^6.12.2",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-transform-modules-commonjs": "^7.25.7",
    "@babel/preset-env": "^7.25.7",
    "@eslint/js": "^9.9.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.0.1",
    "eslint": "^9.9.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "nodemon": "^3.1.4",
    "supertest": "^7.1.1"
  }
}
